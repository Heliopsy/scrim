# SPDX-License-Identifier: AGPL-3.0-only
#
# Everything the release scripts need to know about the source tree and the
# tools they run, in one place. Sourced by scripts/release/lib.sh, read by the
# release workflow. Plain KEY=value lines only: no expansion, no quoting, so
# both bash and the workflow can parse it.

# Source layout contract. The data plane crate is built per target first, then
# copied to SCRIM_DATAPLANE_EMBED before the matching `go build`, which picks it
# up through //go:embed (design D11).
SCRIM_GO_MAIN=.
SCRIM_GO_VERSION_PKG=github.com/heliopsy/scrim/internal/version
SCRIM_GO_TAGS=
SCRIM_DATAPLANE_MANIFEST=dataplane/Cargo.toml
SCRIM_DATAPLANE_PACKAGE=scrim-dataplane
SCRIM_DATAPLANE_BIN=scrim-dataplane
SCRIM_DATAPLANE_EMBED=internal/dataplane/embedded/scrim-dataplane

# Commands the smoke tests run against every built binary and image. Each must
# print the version and exit 0 without a config file or network.
SCRIM_VERSION_CMD=version
SCRIM_DATAPLANE_VERSION_CMD=--version

# Registry and repository the images and attestations belong to.
SCRIM_IMAGE_REGISTRY=ghcr.io/heliopsy
SCRIM_SOURCE_URL=https://github.com/Heliopsy/scrim

# Release tools. Downloaded release assets are checked against these sha256
# values before they run; cargo-auditable is built from crates.io with --locked.
COSIGN_VERSION=v3.1.4
COSIGN_LINUX_AMD64_SHA256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa
SYFT_VERSION=v1.54.0
SYFT_LINUX_AMD64_SHA256=54a87372498168b2d033e876fd41fa4e8035b872699e525a57046e1f2f09c860
CARGO_AUDITABLE_VERSION=0.7.7
