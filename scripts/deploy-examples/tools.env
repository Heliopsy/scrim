# SPDX-License-Identifier: AGPL-3.0-only
#
# Tools `just deploy-examples-check` runs, pinned by version and by the
# sha256 of the linux/amd64 release asset. Plain KEY=value lines, read by
# tools.sh and by the CI job. Bump a tool by changing both lines together.

HELM_VERSION=v4.3.2
HELM_LINUX_AMD64_SHA256=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983
KUSTOMIZE_VERSION=v5.8.3
KUSTOMIZE_LINUX_AMD64_SHA256=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61
KUBECONFORM_VERSION=v0.8.0
KUBECONFORM_LINUX_AMD64_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
COSIGN_VERSION=v3.1.4
COSIGN_LINUX_AMD64_SHA256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa

# The scrim release tools.sh installs through deploy/examples/workstation/install.sh,
# which checks that script against a real signed release. The example configs
# are validated with the image of this tree instead (image.sh).
SCRIM_VERSION=0.1.0

# JSON schemas for kubeconform, pinned by commit: Kubernetes from
# yannh/kubernetes-json-schema, CRDs (Flux, Argo CD, Kyverno, External Secrets,
# Argo CD Image Updater, Prometheus Operator) from datreeio/CRDs-catalog.
KUBERNETES_VERSION=1.37.2
K8S_SCHEMAS_COMMIT=88b0235585da4efb0e4bc6cc00baccf0e327e54d
CRD_SCHEMAS_COMMIT=784ec895547a36e548e6810b41f27baade3a0890

# Container images some checks run in, pinned by digest.
UBUNTU_IMAGE=docker.io/library/ubuntu:24.04@sha256:9c7f200c07e3d4a03e7249d2c16bf66a51120fb876aa2242cf31451412543289
CLOUD_INIT_VERSION=26.2-0ubuntu1~24.04.2
