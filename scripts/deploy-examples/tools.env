# SPDX-License-Identifier: AGPL-3.0-only
#
# Tools `just deploy-examples-check` runs, pinned by version and by the
# sha256 of the linux/amd64 release asset. Plain KEY=value lines, read by
# tools.sh and by the CI job. Renovate bumps the versions (the renovate:
# comments); `just pin-sums` then rewrites each sum from the asset its
# sha256: line names.

# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.2
# sha256: https://get.helm.sh/helm-{version}-linux-amd64.tar.gz
HELM_LINUX_AMD64_SHA256=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983
# renovate: datasource=github-releases depName=kubernetes-sigs/kustomize extractVersion=^kustomize/(?<version>v.+)$
KUSTOMIZE_VERSION=v5.8.3
# sha256: https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F{version}/kustomize_{version}_linux_amd64.tar.gz
KUSTOMIZE_LINUX_AMD64_SHA256=cb9e31198d3f63b44848bd0afc4c8efc56e6cfef9c93a4a39a211940e6decd61
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION=v0.8.0
# sha256: https://github.com/yannh/kubeconform/releases/download/{version}/kubeconform-linux-amd64.tar.gz
KUBECONFORM_LINUX_AMD64_SHA256=9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883
# renovate: datasource=github-releases depName=sigstore/cosign
COSIGN_VERSION=v3.1.4
# sha256: https://github.com/sigstore/cosign/releases/download/{version}/cosign-linux-amd64
COSIGN_LINUX_AMD64_SHA256=424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa

# The scrim release tools.sh installs through deploy/examples/workstation/install.sh,
# which checks that script against a real signed release. The example configs
# are validated with the image of this tree instead (image.sh).
# renovate: datasource=github-releases depName=Heliopsy/scrim extractVersion=^v(?<version>.+)$
SCRIM_VERSION=0.2.0

# JSON schemas for kubeconform, pinned by commit: Kubernetes from
# yannh/kubernetes-json-schema, CRDs (Flux, Argo CD, Kyverno, External Secrets,
# Argo CD Image Updater, Prometheus Operator) from datreeio/CRDs-catalog.
# renovate: datasource=github-releases depName=kubernetes/kubernetes extractVersion=^v(?<version>.+)$
KUBERNETES_VERSION=1.37.2
# renovate: datasource=git-refs depName=yannh/kubernetes-json-schema packageName=https://github.com/yannh/kubernetes-json-schema branch=master
K8S_SCHEMAS_COMMIT=88b0235585da4efb0e4bc6cc00baccf0e327e54d
# renovate: datasource=git-refs depName=datreeio/CRDs-catalog packageName=https://github.com/datreeio/CRDs-catalog branch=main
CRD_SCHEMAS_COMMIT=784ec895547a36e548e6810b41f27baade3a0890

# Container images some checks run in, pinned by digest.
UBUNTU_IMAGE=docker.io/library/ubuntu:26.04@sha256:d66b366dac61b575bee2aef07e9c26e8070096fbe84a3d4d3eb0da069b5d76db
# renovate: datasource=deb depName=cloud-init versioning=deb registryUrl=https://archive.ubuntu.com/ubuntu?suite=resolute-updates&components=main&binaryArch=amd64
CLOUD_INIT_VERSION=26.2-0ubuntu1~26.04.2
