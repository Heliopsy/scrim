# The C toolchain bpf2go compiles internal/bpfredirect/bpf with (`just ebpf`).
# Only clang and llvm-strip run in it; bpf2go itself runs on the host with the
# Go toolchain go.mod names. One Debian release means one clang major, so the
# committed objects are reproducible: `just ebpf-check` rebuilds them in this
# image and fails on any byte difference.

# Pinned by the digest of the multi-arch index; Renovate moves it.
FROM docker.io/library/debian:13.7-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

RUN export DEBIAN_FRONTEND=noninteractive \
 && apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends clang llvm \
 && rm -rf /var/lib/apt/lists/*
