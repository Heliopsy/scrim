# SPDX-License-Identifier: AGPL-3.0-only
#
# The command-line tools the tool profile end-to-end test runs
# (`just e2e-profiles`, CI job e2e-profiles), pinned by version and by the
# sha256 of the linux/amd64 release asset. Plain KEY=value lines, read by
# install.sh. Renovate bumps the versions (the renovate: comments); `just
# pin-sums` then rewrites each sum from the asset its sha256: line names.
# git, curl, skopeo and Python come from the runner image, npm from
# actions/setup-node, cargo from rustup.

# renovate: datasource=github-releases depName=cli/cli extractVersion=^v(?<version>.+)$
GH_VERSION=2.105.0
# sha256: https://github.com/cli/cli/releases/download/v{version}/gh_{version}_linux_amd64.tar.gz
GH_LINUX_AMD64_SHA256=79e7ab5db738c48777b696e374f8b428f0647debfb424f44d2f426370407fe2f
# renovate: datasource=github-releases depName=kubernetes/kubernetes
KUBECTL_VERSION=v1.37.2
# sha256: https://dl.k8s.io/release/{version}/bin/linux/amd64/kubectl
KUBECTL_LINUX_AMD64_SHA256=c04487523e7aa7d1493f7808174c899db93d7a9cf57531420cd76b9bd415f8f4
# renovate: datasource=github-releases depName=helm/helm
HELM_VERSION=v4.3.2
# sha256: https://get.helm.sh/helm-{version}-linux-amd64.tar.gz
HELM_LINUX_AMD64_SHA256=d1c0278d46beab79582d7e50f5b3dc206944ba8e577cde618513fd07daa53983
# renovate: datasource=github-releases depName=hashicorp/terraform extractVersion=^v(?<version>.+)$
TERRAFORM_VERSION=1.17.2
# sha256: https://releases.hashicorp.com/terraform/{version}/terraform_{version}_linux_amd64.zip
TERRAFORM_LINUX_AMD64_SHA256=e6f16b2f0b137ee5729caa8c4e79a3bae4ee261acd198a1fcfa8584a6296605b
# renovate: datasource=github-releases depName=opentofu/opentofu extractVersion=^v(?<version>.+)$
TOFU_VERSION=1.13.9
# sha256: https://github.com/opentofu/opentofu/releases/download/v{version}/tofu_{version}_linux_amd64.tar.gz
TOFU_LINUX_AMD64_SHA256=b34b327cc1ef07178207b6f2cd1f5276537d3e5b7be316500f6dac50d4c0a857
# renovate: datasource=github-releases depName=hetznercloud/cli
HCLOUD_VERSION=v1.70.2
# sha256: https://github.com/hetznercloud/cli/releases/download/{version}/hcloud-linux-amd64.tar.gz
HCLOUD_LINUX_AMD64_SHA256=b844bd28240112b0254183ba5266d0a0f59a6167c196636936459755efb88050
# renovate: datasource=github-releases depName=digitalocean/doctl extractVersion=^v(?<version>.+)$
DOCTL_VERSION=2.7.0
# sha256: https://github.com/digitalocean/doctl/releases/download/v{version}/doctl-{version}-linux-amd64.tar.gz
DOCTL_LINUX_AMD64_SHA256=1033caac941fe6238aa3b3170ac2651117ab259f2eaaa87a252164ed4df405ee
# renovate: datasource=github-tags depName=aws/aws-cli
AWSCLI_VERSION=2.42.1
# sha256: https://awscli.amazonaws.com/awscli-exe-linux-x86_64-{version}.zip
AWSCLI_LINUX_AMD64_SHA256=ff2631c32c5db291b099600f404bc493454ec66c125ff4604625da90480c1f47
# renovate: datasource=docker depName=gcr.io/google.com/cloudsdktool/google-cloud-cli
GCLOUD_VERSION=594.0.0
# sha256: https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-{version}-linux-x86_64.tar.gz
GCLOUD_LINUX_AMD64_SHA256=1f7233537c26bba94a3ea3f9085a60396745eaf44b21b8454fc6fdd15bb6fcde
# Python tools, installed into DIR/venv.
# renovate: datasource=pypi depName=azure-cli
AZURE_CLI_VERSION=2.93.0
# renovate: datasource=pypi depName=twine
TWINE_VERSION=7.0.0
