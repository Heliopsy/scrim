{
  "$id": "https://raw.githubusercontent.com/heliopsy/scrim/main/schema/config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from the scrim settings registry by `scrim config schema`. Do not edit.",
  "properties": {
    "admin": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "default": "",
          "description": "Address of the scrim admin API for operator commands: unix:/path/to/socket or http(s)://host:port. Empty means unix:$XDG_RUNTIME_DIR/scrim/admin.sock.",
          "type": "string",
          "x-scrim-env": "SCRIM_ADMIN_URL",
          "x-scrim-flag": "--admin-url",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "api": {
      "additionalProperties": false,
      "properties": {
        "permissions": {
          "default": "0600",
          "description": "Permission bits of the API socket, octal. Widen (for example 0660) only to let agents running as other local users connect; their identity still comes from peer credentials.",
          "type": "string",
          "x-scrim-env": "SCRIM_API_PERMISSIONS",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        },
        "socket": {
          "default": "",
          "description": "Unix socket of the local agent API. Empty uses $XDG_RUNTIME_DIR/scrim/api.sock.",
          "type": "string",
          "x-scrim-env": "SCRIM_API_SOCKET",
          "x-scrim-flag": "--api-socket",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "apiVersion": {
      "description": "Config file format version.",
      "enum": [
        "scrim.dev/v1"
      ]
    },
    "approvals": {
      "additionalProperties": false,
      "properties": {
        "poll-interval": {
          "default": "1s",
          "description": "How often a waiting operation re-reads its approval from the state backend; bounds how long a decision recorded elsewhere takes to release it.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_APPROVALS_POLL_INTERVAL",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "public-url": {
          "default": "",
          "description": "Base URL under which the decision endpoint is reachable from approvers' devices, for example https://scrim.example.org. Empty means notifiers get no decision links and approvals are decided with scrim approve.",
          "type": "string",
          "x-scrim-env": "SCRIM_APPROVALS_PUBLIC_URL",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "signing-key": {
          "default": "",
          "description": "Reference to the key (at least 32 bytes) that signs decision links, shared by every replica. Empty means a random key per process: links stop working on restart and on other replicas.",
          "type": "string",
          "x-scrim-env": "SCRIM_APPROVALS_SIGNING_KEY",
          "x-scrim-restart-required": false,
          "x-scrim-secret-ref": true,
          "x-scrim-weakening": false
        },
        "timeout": {
          "default": "2m0s",
          "description": "How long an approval waits for a decision before it is denied. A rule's approval.timeout overrides it.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_APPROVALS_TIMEOUT",
          "x-scrim-flag": "--approvals-timeout",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "catalog": {
      "additionalProperties": false,
      "properties": {
        "entries": {
          "additionalProperties": {
            "properties": {},
            "type": "object"
          },
          "description": "Catalog entries by logical name: ref, profiles, variants, prefix, template, hosts, placeholder, class, inject, tools. References only, never values.",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "type": "object",
          "x-scrim-collection": true,
          "x-scrim-env": "SCRIM_CATALOG_ENTRIES",
          "x-scrim-restart-required": false
        },
        "environment": {
          "default": "",
          "description": "Catalog environment that selects per-environment references.",
          "type": "string",
          "x-scrim-env": "SCRIM_CATALOG_ENVIRONMENT",
          "x-scrim-flag": "--catalog-environment",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "files": {
          "default": [],
          "description": "Catalog files to load, in order. Each is a YAML document with `kind: Catalog` and an `entries` map. Reloaded when they change.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-scrim-env": "SCRIM_CATALOG_FILES",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "metadata-from": {
          "default": [],
          "description": "Store prefixes (for example bao://kv/agents) whose secrets' metadata labels are read as catalog entries.",
          "items": {
            "type": "string"
          },
          "type": "array",
          "x-scrim-env": "SCRIM_CATALOG_METADATA_FROM",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "metadata-prefix": {
          "default": "scrim.",
          "description": "Prefix of the store metadata keys read as catalog bindings: <prefix>hosts, <prefix>placeholder, <prefix>profiles, <prefix>name, <prefix>class, <prefix>field.",
          "type": "string",
          "x-scrim-env": "SCRIM_CATALOG_METADATA_PREFIX",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "profile": {
          "default": "",
          "description": "Catalog profile (for example dev or prod) that selects per-profile references.",
          "type": "string",
          "x-scrim-env": "SCRIM_CATALOG_PROFILE",
          "x-scrim-flag": "--catalog-profile",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "reload-interval": {
          "default": "5s",
          "description": "How often catalog files are checked for changes.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_CATALOG_RELOAD_INTERVAL",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "strict": {
          "default": true,
          "description": "Reject config files containing keys scrim does not know. When false, unknown keys are reported as warnings instead.",
          "type": "boolean",
          "x-scrim-env": "SCRIM_CONFIG_STRICT",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "watch": {
          "default": true,
          "description": "Reload the configuration when a config file or an included file changes. SIGHUP always triggers a reload.",
          "type": "boolean",
          "x-scrim-env": "SCRIM_CONFIG_WATCH",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "dataplane": {
      "additionalProperties": false,
      "properties": {
        "memory-lock": {
          "default": "auto",
          "description": "Lock the data plane's memory so values are never swapped: auto locks when the memlock limit is unlimited and warns otherwise; require refuses to start without it.",
          "enum": [
            "auto",
            "require"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_DATAPLANE_MEMORY_LOCK",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        },
        "path": {
          "default": "",
          "description": "Path of a scrim-dataplane binary to run instead of the embedded one. For development builds; release builds embed it.",
          "type": "string",
          "x-scrim-env": "SCRIM_DATAPLANE_PATH",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        },
        "restart-max-backoff": {
          "default": "30s",
          "description": "Longest wait between data plane restarts after repeated crashes.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_DATAPLANE_RESTART_MAX_BACKOFF",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "start-timeout": {
          "default": "10s",
          "description": "How long the data plane may take to start and answer the handshake.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_DATAPLANE_START_TIMEOUT",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "entry": {
      "additionalProperties": false,
      "properties": {
        "listen": {
          "default": "127.0.0.1:0",
          "description": "Loopback address of the page where a human enters a value for secret_ask_human. Port 0 picks a free port.",
          "type": "string",
          "x-scrim-env": "SCRIM_ENTRY_LISTEN",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "grants": {
      "additionalProperties": false,
      "properties": {
        "default-ttl": {
          "default": "30m0s",
          "description": "Grant duration when neither the rule nor the approver chooses one.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_GRANTS_DEFAULT_TTL",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "max-ttl": {
          "default": "8h0m0s",
          "description": "Longest grant any rule or approver can create. A rule's grant.max_ttl can only lower it.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_GRANTS_MAX_TTL",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "peers": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "description": "Agents by local user or group: agent name to space-separated selectors uid:N, user:NAME, gid:N, group:NAME, scope:SCOPE, label:K=V. Empty maps the user scrim runs as to one agent named after it.",
          "type": "object",
          "x-scrim-env": "SCRIM_IDENTITY_PEERS",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "include": {
      "anyOf": [
        {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "optional": {
                  "type": "boolean"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            }
          ]
        },
        {
          "items": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "optional": {
                    "type": "boolean"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        }
      ],
      "description": "Files, globs or directories merged after this file, relative to it."
    },
    "kind": {
      "const": "Config",
      "description": "Document kind."
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "default": "text",
          "description": "Log record format: text (logfmt) or json, one object per line.",
          "enum": [
            "text",
            "json"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_LOG_FORMAT",
          "x-scrim-flag": "--log-format",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "level": {
          "default": "info",
          "description": "Minimum level of log records.",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_LOG_LEVEL",
          "x-scrim-flag": "--log-level",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "listen": {
          "default": "",
          "description": "Address of the metrics and health endpoint (Prometheus format at /metrics, /healthz or /livez, /readyz). Empty disables it; bind to loopback unless scraped remotely.",
          "type": "string",
          "x-scrim-env": "SCRIM_METRICS_LISTEN",
          "x-scrim-flag": "--metrics-listen",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "notify": {
      "additionalProperties": false,
      "properties": {
        "ntfy": {
          "additionalProperties": false,
          "properties": {
            "priority": {
              "default": 4,
              "description": "ntfy message priority, 1 (min) to 5 (max).",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer",
              "x-scrim-env": "SCRIM_NOTIFY_NTFY_PRIORITY",
              "x-scrim-restart-required": false,
              "x-scrim-weakening": false
            },
            "token": {
              "default": "",
              "description": "Reference to an ntfy access token for publishing. Empty publishes anonymously.",
              "type": "string",
              "x-scrim-env": "SCRIM_NOTIFY_NTFY_TOKEN",
              "x-scrim-restart-required": false,
              "x-scrim-secret-ref": true,
              "x-scrim-weakening": false
            },
            "topic": {
              "default": "",
              "description": "ntfy topic approval requests are published to. Anyone who can read the topic sees approval metadata, so use an access-controlled topic or a long random name.",
              "type": "string",
              "x-scrim-env": "SCRIM_NOTIFY_NTFY_TOPIC",
              "x-scrim-restart-required": false,
              "x-scrim-weakening": false
            },
            "url": {
              "default": "",
              "description": "Base URL of the ntfy server, for example https://ntfy.sh. Empty disables the ntfy notifier.",
              "type": "string",
              "x-scrim-env": "SCRIM_NOTIFY_NTFY_URL",
              "x-scrim-restart-required": false,
              "x-scrim-weakening": false
            }
          },
          "type": "object"
        },
        "terminal": {
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "default": true,
              "description": "Print each approval request with its scrim approve and scrim deny commands to the control plane's terminal.",
              "type": "boolean",
              "x-scrim-env": "SCRIM_NOTIFY_TERMINAL_ENABLED",
              "x-scrim-restart-required": false,
              "x-scrim-weakening": false
            }
          },
          "type": "object"
        },
        "webhook": {
          "additionalProperties": false,
          "properties": {
            "hold": {
              "default": "30s",
              "description": "Longest time one submit or poll request is held open by the receiver (sent as X-Nono-Timeout-Secs, capped by the approval's remaining time).",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
              "type": "string",
              "x-scrim-env": "SCRIM_NOTIFY_WEBHOOK_HOLD",
              "x-scrim-restart-required": false,
              "x-scrim-weakening": false
            },
            "poll-interval": {
              "default": "2s",
              "description": "Pause between polls when the receiver answers pending without holding.",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
              "type": "string",
              "x-scrim-env": "SCRIM_NOTIFY_WEBHOOK_POLL_INTERVAL",
              "x-scrim-restart-required": false,
              "x-scrim-weakening": false
            },
            "secret": {
              "default": "",
              "description": "Reference to the shared secret (at least 32 bytes) that signs webhook requests with HMAC-SHA256. Empty sends unsigned requests.",
              "type": "string",
              "x-scrim-env": "SCRIM_NOTIFY_WEBHOOK_SECRET",
              "x-scrim-restart-required": false,
              "x-scrim-secret-ref": true,
              "x-scrim-weakening": false
            },
            "url": {
              "default": "",
              "description": "Approval service URL for the webhook notifier (nono approval webhook v1 compatible). https, or http to a loopback host. Empty disables it.",
              "type": "string",
              "x-scrim-env": "SCRIM_NOTIFY_WEBHOOK_URL",
              "x-scrim-restart-required": false,
              "x-scrim-weakening": false
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "default": "deny",
          "description": "Decision applied when no rule matches. Anything other than deny is reported as a weakened protection.",
          "enum": [
            "deny",
            "ask",
            "allow"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_POLICY_DEFAULT",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": true
        },
        "deny-all": {
          "default": false,
          "description": "Break-glass: deny every injection, grant and approval while redaction continues. While set in configuration it cannot be released from the CLI.",
          "type": "boolean",
          "x-scrim-env": "SCRIM_POLICY_DENY_ALL",
          "x-scrim-flag": "--policy-deny-all",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "deny-all-refresh": {
          "default": "1s",
          "description": "How often each replica re-reads the deny-all state from the state backend; the bound on how long a change on one replica takes to reach the others.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_POLICY_DENY_ALL_REFRESH",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "rules-file": {
          "default": "",
          "description": "Path of the policy rules file (YAML or JSON with default and rules). Empty means no rules: every request gets policy.default.",
          "type": "string",
          "x-scrim-env": "SCRIM_POLICY_RULES_FILE",
          "x-scrim-flag": "--policy-rules-file",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "profile": {
      "default": "local",
      "description": "Built-in preset of defaults for a deployment shape: `local` for a laptop or VM, `k8s` for Kubernetes, `ci` for throwaway runs. Any value a profile sets can be overridden.",
      "enum": [
        "local",
        "k8s",
        "ci"
      ],
      "type": "string",
      "x-scrim-env": "SCRIM_PROFILE",
      "x-scrim-flag": "--profile",
      "x-scrim-restart-required": false,
      "x-scrim-weakening": false
    },
    "run": {
      "additionalProperties": false,
      "properties": {
        "allow-unredacted-start": {
          "default": false,
          "description": "Start the agent anyway when scrim cannot start, its data plane is not ready or no session can be minted. The agent then reaches providers directly and unredacted; scrim run prints a warning.",
          "type": "boolean",
          "x-scrim-env": "SCRIM_RUN_ALLOW_UNREDACTED_START",
          "x-scrim-flag": "--run-allow-unredacted-start",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": true
        },
        "mcp": {
          "default": true,
          "description": "Register scrim mcp with the agent for this session (Claude Code --mcp-config, Codex -c mcp_servers.scrim). Nothing is written to the agent's own configuration.",
          "type": "boolean",
          "x-scrim-env": "SCRIM_RUN_MCP",
          "x-scrim-flag": "--run-mcp",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "placeholder-env": {
          "default": true,
          "description": "Export each declared catalog placeholder that resolves for the session as an environment variable of the same name holding the placeholder, for example SCRIM_ACME_KEY=SCRIM_ACME_KEY.",
          "type": "boolean",
          "x-scrim-env": "SCRIM_RUN_PLACEHOLDER_ENV",
          "x-scrim-flag": "--run-placeholder-env",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "session": {
      "additionalProperties": false,
      "properties": {
        "max-ttl": {
          "default": "168h0m0s",
          "description": "Longest lifetime a session token can be minted with.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_SESSION_MAX_TTL",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        },
        "ttl": {
          "default": "12h0m0s",
          "description": "Default lifetime of a session token minted by scrim run. The token is revoked earlier when scrim run exits.",
          "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
          "type": "string",
          "x-scrim-env": "SCRIM_SESSION_TTL",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "memory",
          "description": "State backend for approvals, grants, sessions and audit metadata. memory writes nothing to disk.",
          "enum": [
            "memory",
            "sqlite",
            "postgres"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_STATE_BACKEND",
          "x-scrim-flag": "--state-backend",
          "x-scrim-restart-required": true,
