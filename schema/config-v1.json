{
  "$id": "https://raw.githubusercontent.com/heliopsy/scrim/main/schema/config-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Generated from the scrim settings registry by `scrim config schema`. Do not edit.",
  "properties": {
    "apiVersion": {
      "description": "Config file format version.",
      "enum": [
        "scrim.dev/v1"
      ]
    },
    "config": {
      "additionalProperties": false,
      "properties": {
        "strict": {
          "default": true,
          "description": "Reject config files containing keys scrim does not know. When false, unknown keys are reported as warnings instead.",
          "type": "boolean",
          "x-scrim-env": "SCRIM_CONFIG_STRICT",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "watch": {
          "default": true,
          "description": "Reload the configuration when a config file or an included file changes. SIGHUP always triggers a reload.",
          "type": "boolean",
          "x-scrim-env": "SCRIM_CONFIG_WATCH",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "include": {
      "anyOf": [
        {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "additionalProperties": false,
              "properties": {
                "optional": {
                  "type": "boolean"
                },
                "path": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "path"
              ],
              "type": "object"
            }
          ]
        },
        {
          "items": {
            "anyOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "optional": {
                    "type": "boolean"
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "path"
                ],
                "type": "object"
              }
            ]
          },
          "type": "array"
        }
      ],
      "description": "Files, globs or directories merged after this file, relative to it."
    },
    "kind": {
      "const": "Config",
      "description": "Document kind."
    },
    "log": {
      "additionalProperties": false,
      "properties": {
        "format": {
          "default": "text",
          "description": "Log record format: text (logfmt) or json, one object per line.",
          "enum": [
            "text",
            "json"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_LOG_FORMAT",
          "x-scrim-flag": "--log-format",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        },
        "level": {
          "default": "info",
          "description": "Minimum level of log records.",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_LOG_LEVEL",
          "x-scrim-flag": "--log-level",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "listen": {
          "default": "",
          "description": "Address of the metrics and health endpoint (Prometheus format at /metrics, /healthz or /livez, /readyz). Empty disables it; bind to loopback unless scraped remotely.",
          "type": "string",
          "x-scrim-env": "SCRIM_METRICS_LISTEN",
          "x-scrim-flag": "--metrics-listen",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    },
    "policy": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "default": "deny",
          "description": "Decision applied when no rule matches. Anything other than deny is reported as a weakened protection.",
          "enum": [
            "deny",
            "ask",
            "allow"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_POLICY_DEFAULT",
          "x-scrim-restart-required": false,
          "x-scrim-weakening": true
        }
      },
      "type": "object"
    },
    "profile": {
      "default": "local",
      "description": "Built-in preset of defaults for a deployment shape: `local` for a laptop or VM, `k8s` for Kubernetes, `ci` for throwaway runs. Any value a profile sets can be overridden.",
      "enum": [
        "local",
        "k8s",
        "ci"
      ],
      "type": "string",
      "x-scrim-env": "SCRIM_PROFILE",
      "x-scrim-flag": "--profile",
      "x-scrim-restart-required": false,
      "x-scrim-weakening": false
    },
    "state": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "default": "memory",
          "description": "State backend for approvals, grants, sessions and audit metadata. memory writes nothing to disk.",
          "enum": [
            "memory",
            "sqlite",
            "postgres"
          ],
          "type": "string",
          "x-scrim-env": "SCRIM_STATE_BACKEND",
          "x-scrim-flag": "--state-backend",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        },
        "postgres": {
          "additionalProperties": false,
          "properties": {
            "connect-timeout": {
              "default": "15s",
              "description": "How long start-up waits for PostgreSQL to answer before failing.",
              "pattern": "^[-+]?(0|(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+)$",
              "type": "string",
              "x-scrim-env": "SCRIM_STATE_POSTGRES_CONNECT_TIMEOUT",
              "x-scrim-restart-required": true,
              "x-scrim-weakening": false
            },
            "dsn": {
              "default": "",
              "description": "Reference to the PostgreSQL connection string (postgres://user:pass@host/db?sslmode=verify-full), for example env:SCRIM_PG_DSN or file:/run/secrets/scrim-dsn. It holds a password, so it is a reference.",
              "type": "string",
              "x-scrim-env": "SCRIM_STATE_POSTGRES_DSN",
              "x-scrim-restart-required": true,
              "x-scrim-secret-ref": true,
              "x-scrim-weakening": false
            },
            "max-conns": {
              "default": 16,
              "description": "Maximum connections in the PostgreSQL pool.",
              "maximum": 9223372036854775807,
              "minimum": -9223372036854775808,
              "type": "integer",
              "x-scrim-env": "SCRIM_STATE_POSTGRES_MAX_CONNS",
              "x-scrim-restart-required": true,
              "x-scrim-weakening": false
            }
          },
          "type": "object"
        },
        "sqlite": {
          "additionalProperties": false,
          "properties": {
            "allow-network-filesystem": {
              "default": false,
              "description": "Allows the SQLite state file on a network or shared filesystem (NFS, SMB, sshfs), where file locking is unreliable and the database can be corrupted. Use the postgres backend instead.",
              "type": "boolean",
              "x-scrim-env": "SCRIM_STATE_SQLITE_ALLOW_NETWORK_FILESYSTEM",
              "x-scrim-restart-required": true,
              "x-scrim-weakening": true
            },
            "path": {
              "default": "",
              "description": "SQLite state file. Empty means $XDG_STATE_HOME/scrim/state.db (~/.local/state/scrim/state.db).",
              "type": "string",
              "x-scrim-env": "SCRIM_STATE_SQLITE_PATH",
              "x-scrim-flag": "--state-sqlite-path",
              "x-scrim-restart-required": true,
              "x-scrim-weakening": false
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "tracing": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "default": "",
          "description": "OTLP/HTTP collector URL for traces, for example http://127.0.0.1:4318. Empty disables export; incoming W3C trace context is still propagated.",
          "type": "string",
          "x-scrim-env": "SCRIM_TRACING_ENDPOINT",
          "x-scrim-flag": "--tracing-endpoint",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        },
        "sample-ratio": {
          "default": 1,
          "description": "Fraction of new root traces sampled, 0 to 1. A sampled incoming parent is always followed.",
          "type": "number",
          "x-scrim-env": "SCRIM_TRACING_SAMPLE_RATIO",
          "x-scrim-restart-required": true,
          "x-scrim-weakening": false
        }
      },
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind"
  ],
  "title": "scrim configuration file (scrim.dev/v1)",
  "type": "object"
}
