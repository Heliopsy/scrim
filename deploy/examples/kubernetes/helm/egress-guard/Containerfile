# Image for the sidecar egress guard (sidecar.egressGuard.image): a shell and
# nft, nothing else. Build and push with podman:
#   podman build -t registry.example.com/platform/nft:3.22 egress-guard/
#   podman push registry.example.com/platform/nft:3.22
FROM docker.io/library/alpine:3.22
RUN apk add --no-cache nftables
