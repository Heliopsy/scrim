#
# Not built. The third-party images the chart's defaults pull, one FROM line
# each, so Dependabot (.github/dependabot.yml, docker) proposes new tags and
# digests for them. verify.sh fails until values.yaml names the same
# reference: copy it there in the Dependabot pull request and run
# `ci/verify.sh --generate`. The scrim image follows the release
# (Chart.yaml appVersion) and is not listed.
FROM docker.io/curlimages/curl:8.23.0@sha256:3fb7e13e5d179a845c97d78204f3f1064d1907037f26a3ebf91710571151fd93
