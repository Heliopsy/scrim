{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "go",
  "include-component-in-tag": false,
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": false,
  "packages": {
    ".": {
      "package-name": "scrim",
      "extra-files": [
        {
          "type": "generic",
          "path": "deploy/examples/argocd/application-helm.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/helm/scrim/Chart.yaml"
        },
        {
          "type": "generic",
          "path": "docs/helm-values.md"
        },
        {
          "type": "generic",
          "path": "deploy/examples/ansible/roles/scrim/defaults/main.yml"
        },
        {
          "type": "generic",
          "path": "deploy/examples/cloud-init/user-data.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/examples/kubernetes/kustomize/base/deployment.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/examples/kubernetes/kustomize/base/kustomization.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/examples/kubernetes/kustomize/overlays/prod/kustomization.yaml"
