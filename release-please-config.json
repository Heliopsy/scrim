        {
          "type": "generic",
          "path": "deploy/examples/kubernetes/raw/30-deployment.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/examples/podman/compose/compose.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/examples/podman/kube/scrim.yaml"
        },
        {
          "type": "generic",
          "path": "deploy/examples/podman/run.sh"
        },
        {
          "type": "generic",
          "path": "deploy/examples/workstation/install.sh"
        },
        {
          "type": "generic",
          "path": "scripts/deploy-examples/cloud-init.py"
        }
      ]
    }
  }
}
