# SPDX-License-Identifier: AGPL-3.0-only
#
# Root file system of the throwaway VM test/ebpf/install-test.sh boots:
# Debian with systemd, the system trust store tools, curl for the agent and
# iproute2 for the stand-in provider address. Exported to a disk image, never
# run as a container. Not shipped; built and removed by the test.
FROM docker.io/library/debian:trixie-slim

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      systemd systemd-sysv dbus ca-certificates curl jq passwd procps iproute2 \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && systemctl mask apt-daily.timer apt-daily-upgrade.timer dpkg-db-backup.timer e2scrub_all.timer fstrim.timer \
      systemd-tmpfiles-clean.timer getty@tty1.service serial-getty@ttyS0.service \
 && useradd --create-home --uid 1001 --shell /bin/bash bob
